# Frontend değişkenleri. Gerçek değerler .env.local dosyasına (yerel) ve apphosting.yaml'a (Firebase App Hosting) yazılır.
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider; buraya gizli değer yazılmaz.

# Backend adresi (rewrites hedefi). Yerelde uvicorn, yayında Cloud Run adresi.
API_BASE_URL=http://localhost:8000

# QR sayfasının (/qr) göstereceği adres. Boşsa sayfanın açıldığı adres kullanılır.
NEXT_PUBLIC_SITE_URL=

# 1 iken backend yerine src/mocks/ altındaki sahte veri kullanılır.
NEXT_PUBLIC_SAHTE_VERI=1

# Firebase web uygulaması ayarları (Firebase konsolu > Proje ayarları > Uygulamalarınız > Web).
# Bunlar gizli değildir; yetkiyi Firebase Auth ve backend kontrol eder.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Yalnızca yerel deneme: Firebase Auth emülatörü (npx firebase emulators:start --only auth).
# Yayında boş bırakın. Örnek: http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=
