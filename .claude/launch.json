{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && python -m uvicorn app.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && python -m uvicorn app.main:app --port 8001"],
      "port": 8001
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_BASE_URL=http://localhost:8001&& npm run dev --prefix frontend -- -p 3001"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    }
  ]
}
