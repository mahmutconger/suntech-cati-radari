rules_version = '2';

// İstemci Firestore'a doğrudan bağlanmaz; tüm erişim backend (admin SDK) üzerinden.
// Bu kurallar güvenlik katmanı olarak her şeyi kapatır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
