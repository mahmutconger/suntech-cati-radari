# Değişken adları. Gerçek değerler .env dosyasına ve Vercel'e yazılır; .env repoya girmez.
# Supabase değişkenlerini Vercel'deki entegrasyon kendisi ekler; yerelde vercel env pull ile gelir.

# Backend (Vercel api projesi)
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Supabase entegrasyonundan. POSTGRES_URL işlem modu (6543); NON_POOLING laptoptaki betikler ve migration için.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
# Yalnızca token başlığında alg HS256 görünürse kullanılır.
SUPABASE_JWT_SECRET=

# Frontend (Vercel web projesi). NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider, buraya gizli değer yazılmaz.
API_BASE_URL=http://localhost:8000
# Supabase entegrasyonundan.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
