# Değişken adları. Gerçek değerler .env dosyasına ve Vercel'e yazılır; .env repoya girmez.

# Backend (Vercel api projesi)
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Firebase servis hesabı anahtarı. İki seçenek:
# 1. JSON dosya yolu: FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# 2. Base64 kodlanmış JSON: FIREBASE_SERVICE_ACCOUNT=eyJ0eXAi...
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Frontend (Vercel web projesi). NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider, buraya gizli değer yazılmaz.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
