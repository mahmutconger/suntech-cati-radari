# Backend değişkenleri (backend/.env, yayında Cloud Run). .env repoya girmez.
# Frontend değişkenleri frontend/.env.example'da.

GEMINI_API_KEY=
# Virgülle sıralı; model 503/429 verirse sıradakine geçilir.
GEMINI_MODELLER=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# 1 iken Gemini'ye istek gitmez, şablon cevap döner (anahtar boşsa da sahte mod).
GEMINI_SAHTE=0
CORS_ORIGINS=http://localhost:3000
# Firebase servis hesabı anahtarı. İki seçenek:
# 1. JSON dosya yolu: FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# 2. Base64 kodlanmış JSON: FIREBASE_SERVICE_ACCOUNT=eyJ0eXAi...
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
