# Değişken adları. Gerçek değerler .env dosyasına ve Vercel'e yazılır; .env repoya girmez.
# DATABASE_URL ve DATABASE_URL_UNPOOLED'ı Vercel'deki Neon entegrasyonu ekler; yerelde vercel env pull ile gelir.

# Backend (Vercel api projesi)
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Neon havuzlu adres, Vercel fonksiyonu için.
DATABASE_URL=
# Neon doğrudan adres, laptoptaki betikler ve migration için.
DATABASE_URL_UNPOOLED=
# Giriş token'larını imzalar. Uzun ve rastgele olmalı: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_GIZLI=

# Frontend (Vercel web projesi). NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider, buraya gizli değer yazılmaz.
API_BASE_URL=http://localhost:8000
